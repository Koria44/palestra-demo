# Configuracion de entorno para PALESTRA - Gestion de Actividades Deportivas Estudiantiles
# IMPORTANTE: Copie este archivo a .env y reemplace los valores de ejemplo por claves reales generadas.
# Nunca suba el archivo .env al repositorio.

# Entorno de ejecucion (config.desarrollo o config.produccion)
DJANGO_SETTINGS_MODULE=config.desarrollo

# Clave secreta de Django (minimo 50 caracteres aleatorios)
SECRET_KEY=clave-secreta-de-ejemplo-no-usar-en-produccion-cambiar-por-valor-seguro-50-chars
# Claves anteriores separadas por coma para rotacion sin invalidar sesiones activas
SECRET_KEY_FALLBACKS=

# Modo depuracion (True solo en desarrollo local, False obligatorio en produccion)
DEBUG=True

# Hosts y origenes permitidos separados por coma
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Conexion a Supabase (PostgreSQL)
# DATABASE_URL: Pooler de conexiones en modo transaccion (puerto 6543) para la aplicacion
DATABASE_URL=postgresql://palestra_app:contrasena_ejemplo_falsa@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_URL_DIRECT: Conexion directa (puerto 5432) para ejecutar migraciones
DATABASE_URL_DIRECT=postgresql://postgres:contrasena_ejemplo_falsa@db.proyecto-ejemplo.supabase.co:5432/postgres?sslmode=require
# Si USAR_SQLITE_LOCAL=True en desarrollo, se usa SQLite local cuando no hay red hacia Supabase
USAR_SQLITE_LOCAL=True

# Claves de cifrado a nivel de campo (generar con: python manage.py generar_claves)
# MultiFernet admite multiples claves separadas por coma (la primera cifra, todas descifran para rotacion)
CLAVE_CIFRADO_CAMPOS=ZHVtbXktZmVybmV0LWtleS1mb3ItZXhhbXBsZS1vbmx5LTIzNDU2Nzg5MDEy=
# Clave independiente para HMAC-SHA256 de indices ciegos (busqueda exacta de RUT sin exponer texto plano)
CLAVE_INDICE_CIEGO=clave-hmac-indice-ciego-ejemplo-falso-reemplazar-con-generar-claves

# Parametros de costo de Argon2id (OWASP recomienda memoria >= 19456 KiB, iteraciones >= 2)
ARGON2_MEMORIA_KIB=19456
ARGON2_ITERACIONES=2
ARGON2_PARALELISMO=1

# Configuracion de correo electronico (para enlaces de activacion y recuperacion de contrasena)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.ejemplo.cl
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=no-responder@palestra.institucion.cl
EMAIL_HOST_PASSWORD=contrasena_smtp_falsa
DEFAULT_FROM_EMAIL=PALESTRA Gestion Deportiva <no-responder@palestra.institucion.cl>

# Tiempo de expiracion de enlaces de un solo uso (en segundos)
TIEMPO_EXPIRACION_ACTIVACION_SEGUNDOS=86400
PASSWORD_RESET_TIMEOUT=3600
